# Aplicação e Redis em contentores; a MariaDB corre no anfitrião (só aceita ligações locais).
x-logging: &logging
  driver: json-file
  options: { max-size: "20m", max-file: "5" }

services:
  redis:
    image: redis:8
    command: ["redis-server", "--appendonly", "yes", "--appendfsync", "everysec", "--bind", "127.0.0.1", "--protected-mode", "yes"]
    volumes: ["redis-data:/data"]
    network_mode: host
    restart: unless-stopped
    mem_limit: 1g
    logging: *logging

  api:
    image: cpq/api:{{ app_image_tag }}
    network_mode: host
    restart: unless-stopped
    mem_limit: 2g
    environment:
      NODE_ENV: production
      PORT: "3000"
      DOCUMENT_STORAGE_DIR: /data/documents
      TLS_CERT_FILE: /etc/cpq/tls/portal.crt
    volumes:
      - "{{ documents_dir }}:/data/documents"
      - "{{ tls_dir }}/portal.crt:/etc/cpq/tls/portal.crt:ro"
    logging: *logging
    env_file: ["{{ app_dir }}/api.env"]   # preenchido a partir do Secrets Manager no deploy

  worker:
    image: cpq/worker:{{ app_image_tag }}
    network_mode: host
    restart: unless-stopped
    mem_limit: 1g
    environment:
      NODE_ENV: production
      DOCUMENT_STORAGE_DIR: /data/documents
      AUDIT_EXPORT_DIR: /data/audit
      TLS_CERT_FILE: /etc/cpq/tls/portal.crt
    volumes:
      - "{{ documents_dir }}:/data/documents"
      - "{{ audit_export_dir }}:/data/audit"
      - "{{ tls_dir }}/portal.crt:/etc/cpq/tls/portal.crt:ro"
    logging: *logging
    env_file: ["{{ app_dir }}/worker.env"]

  web:
    image: cpq/web:{{ app_image_tag }}
    ports: ["127.0.0.1:8081:80"]
    restart: unless-stopped
    logging: *logging

volumes:
  redis-data:
