{
  "name": "@cpq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "node --import @swc-node/register/esm-register scripts/migrate.ts",
    "seed": "node --import @swc-node/register/esm-register seed/seed.ts",
    "test": "vitest run",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "user:create": "node --import @swc-node/register/esm-register scripts/create-user.ts",
    "ops:verify": "node --import @swc-node/register/esm-register scripts/verify-integrity.ts",
    "import": "node --import @swc-node/register/esm-register scripts/import.ts"
  },
  "dependencies": {
    "@cpq/rules-engine": "workspace:*",
    "@cpq/shared": "workspace:*",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "mariadb": "^3.5.4"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "prisma": "~7.10.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  }
}
