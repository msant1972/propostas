{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "DOCUMENT_STORAGE_DIR",
    "AUDIT_EXPORT_DIR",
    "MAIL_OUTBOX_DIR",
    "AUTH_JWT_SECRET",
    "AUTH_TOKEN_TTL_HOURS",
    "APP_BASE_URL",
    "PORTAL_BASE_URL",
    "WEB_ORIGIN",
    "SMTP_URL",
    "MAIL_FROM",
    "TEAMS_WEBHOOK_URL",
    "TLS_CERT_FILE",
    "SCHEDULER_ENABLED",
    "LOGIN_RATE_PER_MINUTE"
  ]
}
