# Entrada HTTPS do servidor: aplicação e portal do cliente, com certificado autoassinado.
limit_req_zone $binary_remote_addr zone=portal:10m rate=30r/m;   # portal: pedidos por IP
limit_req_zone $binary_remote_addr zone=api:10m rate=600r/m;

server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name {{ server_names | join(' ') }};

    ssl_certificate     {{ tls_dir }}/portal.crt;
    ssl_certificate_key {{ tls_dir }}/portal.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 25m;

    # Portal do cliente: limite de pedidos mais apertado (as ligações têm token e resposta única)
    location /api/v1/portal/ {
        limit_req zone=portal burst=20 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        limit_req zone=api burst=100 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;   # contentor com a SPA estática
        proxy_set_header Host $host;
    }
}
