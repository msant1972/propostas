#!/bin/sh
# Backup completo diário com mariabackup, copiado para o destino separado ({{ backup_target }}).
set -eu
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
DEST=/var/backups/cpq/full-$STAMP
mkdir -p "$DEST"
mariadb-backup --backup --target-dir="$DEST" --user=backup --socket=/run/mysqld/mysqld.sock
mariadb-backup --prepare --target-dir="$DEST"
tar -C /var/backups/cpq -czf "/var/backups/cpq/full-$STAMP.tar.gz" "full-$STAMP"
rsync -a "/var/backups/cpq/full-$STAMP.tar.gz" "{{ backup_target }}/full/"
rm -rf "$DEST" "/var/backups/cpq/full-$STAMP.tar.gz"
# documentos e exportações da auditoria (ficheiros novos, nunca sobrescritos)
rsync -a "{{ documents_dir }}/" "{{ backup_target }}/documents/"
rsync -a "{{ audit_export_dir }}/" "{{ backup_target }}/audit/"
# retenção: 35 dias
find "/var/backups/cpq" -name 'full-*' -mtime +35 -delete
