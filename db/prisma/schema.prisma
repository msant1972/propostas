// O esquema físico é gerido por migrações SQL (db/migrations): colunas UUID nativas, triggers e
// colunas geradas não são expressáveis em Prisma. Este ficheiro descreve o mesmo esquema para o
// cliente tipado e tem de ser mantido em sincronia com as migrações.
generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

enum BillingModel {
  ONE_TIME
  RECURRING
  USAGE_BASED
  MILESTONE
}

enum BillingPeriod {
  MONTH
  QUARTER
  YEAR
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Team {
  id         String  @id @db.Char(36)
  name       String  @unique @db.VarChar(100)
  leadUserId String? @map("lead_user_id") @db.Char(36)
  users      User[]

  @@map("teams")
}

model User {
  id          String   @id @db.Char(36)
  entraOid    String   @unique @map("entra_oid") @db.Char(36)
  email       String   @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  teamId      String?  @map("team_id") @db.Char(36)
  region      String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  rolesJson   Json?    @map("roles_json")
  lastSeenAt  DateTime? @map("last_seen_at") @db.DateTime(6)
  team        Team?    @relation(fields: [teamId], references: [id])

  @@map("users")
}

model Product {
  id            String         @id @db.Char(36)
  sku           String         @unique @db.VarChar(50)
  name          String         @db.VarChar(255)
  description   String?        @db.Text
  unitOfMeasure String         @default("UN") @map("unit_of_measure") @db.VarChar(20)
  billingModel  BillingModel   @map("billing_model")
  billingPeriod BillingPeriod? @map("billing_period")
  unitCost      Decimal        @default(0) @map("unit_cost") @db.Decimal(15, 4)
  costCurrency  String         @default("EUR") @map("cost_currency") @db.Char(3)
  taxCategory   String         @default("STANDARD") @map("tax_category") @db.VarChar(30)
  isActive      Boolean        @default(true) @map("is_active")
  rowVersion    Int            @default(1) @map("row_version")
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  @@map("products")
}

model OutboxEvent {
  id            String       @id @db.Char(36)
  aggregateId   String       @map("aggregate_id") @db.Char(36)
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0) @db.SmallInt
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.DateTime(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  lastError     String?      @map("last_error") @db.Text

  @@index([status, nextAttemptAt], map: "ix_outbox_pending")
  @@map("outbox_events")
}

model AuditLog {
  seq         BigInt   @id @default(autoincrement())
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.DateTime(6)
  actorUserId String?  @map("actor_user_id") @db.Char(36)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Char(36)
  action      String   @db.VarChar(50)
  diffJson    Json     @map("diff_json")
  prevHash    String   @map("prev_hash") @db.Char(64)
  rowHash     String   @map("row_hash") @db.Char(64)

  @@index([entityType, entityId], map: "ix_audit_entity")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// Fase 2 — CPQ (migrações 0002 e 0003)
// ---------------------------------------------------------------------------------------------

enum AttributeDataType {
  INTEGER
  DECIMAL
  LIST
  BOOLEAN
}

enum TaxRegimeDb {
  STANDARD
  REDUCED
  EXEMPT
  REVERSE_CHARGE
  OUTSIDE_SCOPE

  @@map("TaxRegime")
}

enum RuleTypeDb {
  REQUIRES
  EXCLUDES
  RECOMMENDS
  CONSTRAINT
  DEFAULT

  @@map("RuleType")
}

enum ProposalStatus {
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum QuoteVersionStatus {
  DRAFT
  LOCKED
  SUPERSEDED
}

model Client {
  id            String    @id @db.Char(36)
  code          String    @unique @db.VarChar(50)
  name          String    @db.VarChar(255)
  vatNumber     String?   @map("vat_number") @db.VarChar(30)
  countryCode   String    @map("country_code") @db.Char(2)
  tier          String?   @db.VarChar(30)
  vatValid      Boolean   @default(false) @map("vat_valid")
  crmExternalId String?   @unique @map("crm_external_id") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(6)
  proposals     Proposal[]

  @@map("clients")
}

model ProductAttribute {
  id                String            @id @db.Char(36)
  productId         String            @map("product_id") @db.Char(36)
  code              String            @db.VarChar(50)
  label             String            @db.VarChar(100)
  dataType          AttributeDataType @map("data_type")
  minValue          Decimal?          @map("min_value") @db.Decimal(15, 4)
  maxValue          Decimal?          @map("max_value") @db.Decimal(15, 4)
  stepValue         Decimal?          @map("step_value") @db.Decimal(15, 4)
  allowedValuesJson Json?             @map("allowed_values_json")
  isRequired        Boolean           @default(false) @map("is_required")
  defaultValue      String?           @map("default_value") @db.VarChar(100)

  @@unique([productId, code], map: "uq_pa")
  @@map("product_attributes")
}

model ProductBundleItem {
  id                 String   @id @db.Char(36)
  bundleProductId    String   @map("bundle_product_id") @db.Char(36)
  componentProductId String   @map("component_product_id") @db.Char(36)
  isRequired         Boolean  @default(true) @map("is_required")
  defaultQuantity    Decimal  @default(1) @map("default_quantity") @db.Decimal(12, 3)
  minQuantity        Decimal? @map("min_quantity") @db.Decimal(12, 3)
  maxQuantity        Decimal? @map("max_quantity") @db.Decimal(12, 3)
  sortOrder          Int      @default(0) @map("sort_order") @db.SmallInt

  @@unique([bundleProductId, componentProductId], map: "uq_pbi")
  @@map("product_bundle_items")
}

model TaxRate {
  id              String      @id @db.Char(36)
  countryCode     String      @map("country_code") @db.Char(2)
  taxCategory     String      @default("STANDARD") @map("tax_category") @db.VarChar(30)
  regime          TaxRegimeDb
  ratePercent     Decimal     @map("rate_percent") @db.Decimal(5, 2)
  exemptionReason String?     @map("exemption_reason") @db.VarChar(255)
  validFrom       DateTime    @map("valid_from") @db.Date
  validTo         DateTime?   @map("valid_to") @db.Date

  @@unique([countryCode, taxCategory, regime, validFrom], map: "uq_tax")
  @@map("tax_rates")
}

model FxRate {
  id            String   @id @db.Char(36)
  baseCurrency  String   @map("base_currency") @db.Char(3)
  quoteCurrency String   @map("quote_currency") @db.Char(3)
  rate          Decimal  @db.Decimal(18, 8)
  rateDate      DateTime @map("rate_date") @db.Date
  source        String   @db.VarChar(50)

  @@unique([baseCurrency, quoteCurrency, rateDate], map: "uq_fx")
  @@map("fx_rates")
}

model PriceList {
  id         String          @id @db.Char(36)
  name       String          @db.VarChar(100)
  currency   String          @db.Char(3)
  region     String?         @db.VarChar(50)
  channel    String?         @db.VarChar(50)
  clientTier String?         @map("client_tier") @db.VarChar(30)
  validFrom  DateTime        @map("valid_from") @db.Date
  validTo    DateTime?       @map("valid_to") @db.Date
  items      PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @db.Char(36)
  priceListId String    @map("price_list_id") @db.Char(36)
  productId   String    @map("product_id") @db.Char(36)
  minQuantity Decimal   @default(0) @map("min_quantity") @db.Decimal(12, 3)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(15, 4)
  priceList   PriceList @relation(fields: [priceListId], references: [id])

  @@unique([priceListId, productId, minQuantity], map: "uq_pli")
  @@map("price_list_items")
}

model CpqRule {
  id              String     @id @db.Char(36)
  sourceProductId String     @map("source_product_id") @db.Char(36)
  targetProductId String?    @map("target_product_id") @db.Char(36)
  ruleType        RuleTypeDb @map("rule_type")
  paramsJson      Json?      @map("params_json")
  conditionJson   Json?      @map("condition_json")
  priority        Int        @default(100) @db.SmallInt
  message         String?    @db.VarChar(255)
  validFrom       DateTime   @map("valid_from") @db.Date
  validTo         DateTime?  @map("valid_to") @db.Date
  isActive        Boolean    @default(true) @map("is_active")

  @@map("cpq_rules")
}

model Proposal {
  id              String         @id @db.Char(36)
  code            String         @unique @db.VarChar(50)
  title           String         @db.VarChar(255)
  clientId        String         @map("client_id") @db.Char(36)
  ownerUserId     String         @map("owner_user_id") @db.Char(36)
  ownerTeamId     String?        @map("owner_team_id") @db.Char(36)
  region          String?        @db.VarChar(50)
  status          ProposalStatus @default(DRAFT)
  currency        String         @default("EUR") @db.Char(3)
  language        String         @default("pt-PT") @db.Char(5)
  validUntil      DateTime?      @map("valid_until") @db.Date
  folderPath      String?        @map("folder_path") @db.VarChar(500)
  sentAt          DateTime?      @map("sent_at") @db.DateTime(6)
  statusReason    String?        @map("status_reason") @db.VarChar(500)
  rowVersion      Int            @default(1) @map("row_version")
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt       DateTime?      @map("deleted_at") @db.DateTime(6)
  client          Client         @relation(fields: [clientId], references: [id])
  quoteVersions   QuoteVersion[]

  @@index([ownerUserId, status], map: "ix_prop_owner_status")
  @@map("proposals")
}

model QuoteVersion {
  id             String             @id @db.Char(36)
  proposalId     String             @map("proposal_id") @db.Char(36)
  versionNumber  Int                @map("version_number")
  status         QuoteVersionStatus @default(DRAFT)
  isCurrent      Boolean            @default(true) @map("is_current")
  priceListId    String             @map("price_list_id") @db.Char(36)
  currency       String             @db.Char(3)
  fxRateToEur    Decimal            @default(1) @map("fx_rate_to_eur") @db.Decimal(18, 8)
  subtotal       Decimal            @default(0) @db.Decimal(15, 2)
  discountPercent Decimal           @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount Decimal            @default(0) @map("discount_amount") @db.Decimal(15, 2)
  totalTax       Decimal            @default(0) @map("total_tax") @db.Decimal(15, 2)
  grandTotal     Decimal            @default(0) @map("grand_total") @db.Decimal(15, 2)
  totalMrr       Decimal            @default(0) @map("total_mrr") @db.Decimal(15, 2)
  totalTcv       Decimal            @default(0) @map("total_tcv") @db.Decimal(15, 2)
  marginPercent  Decimal?           @map("margin_percent") @db.Decimal(6, 2)
  snapshotJson   Json?              @map("snapshot_json")
  snapshotHash   String?            @map("snapshot_hash") @db.Char(64)
  lockedAt       DateTime?          @map("locked_at") @db.DateTime(6)
  createdBy      String             @map("created_by") @db.Char(36)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(6)
  proposal       Proposal           @relation(fields: [proposalId], references: [id])
  items          QuoteItem[]

  @@unique([proposalId, versionNumber], map: "uq_qv_number")
  @@map("quote_versions")
}

model QuoteItem {
  id                   String       @id @db.Char(36)
  quoteVersionId       String       @map("quote_version_id") @db.Char(36)
  lineNumber           Int          @map("line_number") @db.SmallInt
  productId            String       @map("product_id") @db.Char(36)
  productNameSnapshot  String       @map("product_name_snapshot") @db.VarChar(255)
  attributesJson       Json?        @map("attributes_json")
  quantity             Decimal      @db.Decimal(12, 3)
  termMonths           Int?         @map("term_months") @db.SmallInt
  listUnitPrice        Decimal      @map("list_unit_price") @db.Decimal(15, 4)
  unitCost             Decimal      @map("unit_cost") @db.Decimal(15, 4)
  costFxRate           Decimal      @default(1) @map("cost_fx_rate") @db.Decimal(18, 8)
  discountPercent      Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  netUnitPrice         Decimal      @map("net_unit_price") @db.Decimal(15, 4)
  globalDiscountAmount Decimal      @default(0) @map("global_discount_amount") @db.Decimal(15, 2)
  taxRatePercent       Decimal      @map("tax_rate_percent") @db.Decimal(5, 2)
  taxRegime            String       @default("STANDARD") @map("tax_regime") @db.VarChar(20)
  taxAmount            Decimal      @default(0) @map("tax_amount") @db.Decimal(15, 2)
  lineTotal            Decimal      @map("line_total") @db.Decimal(15, 2)
  quoteVersion         QuoteVersion @relation(fields: [quoteVersionId], references: [id])

  @@unique([quoteVersionId, lineNumber], map: "uq_qi_line")
  @@map("quote_items")
}

// ---------------------------------------------------------------------------------------------
// Fase 3 — Conteúdos, secções e documentos (migração 0004)
// ---------------------------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum DocumentKind {
  DOCX
  PDF
  SIGNED_PDF
  ATTACHMENT
}

enum DocumentOrigin {
  GENERATED
  MANUALLY_EDITED
  UPLOADED
}

enum DocumentFolder {
  F01_TRABALHO @map("01_Trabalho")
  F02_ENVIADO  @map("02_Enviado")
  F03_ASSINADO @map("03_Assinado")
}

model ContentBlock {
  id          String                @id @db.Char(36)
  code        String                @unique @db.VarChar(50)
  title       String                @db.VarChar(255)
  isLegal     Boolean               @default(false) @map("is_legal")
  ownerUserId String                @map("owner_user_id") @db.Char(36)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(6)
  deletedAt   DateTime?             @map("deleted_at") @db.DateTime(6)
  versions    ContentBlockVersion[]
  tags        ContentBlockTag[]

  @@map("content_blocks")
}

model ContentBlockVersion {
  id            String        @id @db.Char(36)
  blockId       String        @map("block_id") @db.Char(36)
  language      String        @db.Char(5)
  versionNumber Int           @map("version_number")
  status        ContentStatus @default(DRAFT)
  bodyHtml      String        @map("body_html") @db.MediumText
  reviewDueDate DateTime      @map("review_due_date") @db.Date
  createdBy     String        @map("created_by") @db.Char(36)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  block         ContentBlock  @relation(fields: [blockId], references: [id])

  @@unique([blockId, language, versionNumber], map: "uq_cbv")
  @@map("content_block_versions")
}

model Tag {
  id     String            @id @db.Char(36)
  name   String            @unique @db.VarChar(50)
  blocks ContentBlockTag[]

  @@map("tags")
}

model ContentBlockTag {
  blockId String       @map("block_id") @db.Char(36)
  tagId   String       @map("tag_id") @db.Char(36)
  block   ContentBlock @relation(fields: [blockId], references: [id])
  tag     Tag          @relation(fields: [tagId], references: [id])

  @@id([blockId, tagId])
  @@map("content_block_tags")
}

model ProposalSection {
  id             String    @id @db.Char(36)
  proposalId     String    @map("proposal_id") @db.Char(36)
  position       Int       @db.SmallInt
  title          String    @db.VarChar(255)
  blockVersionId String?   @map("block_version_id") @db.Char(36)
  isModified     Boolean   @default(false) @map("is_modified")
  rowVersion     Int       @default(1) @map("row_version")
  document       SectionDocument?

  @@index([proposalId, position], map: "ix_ps_order")
  @@map("proposal_sections")
}

model SectionDocument {
  sectionId  String          @id @map("section_id") @db.Char(36)
  ydocState  Bytes           @map("ydoc_state")
  htmlCache  String?         @map("html_cache") @db.MediumText
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)
  section    ProposalSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("section_documents")
}

model Document {
  id             String         @id @db.Char(36)
  proposalId     String         @map("proposal_id") @db.Char(36)
  quoteVersionId String?        @map("quote_version_id") @db.Char(36)
  kind           DocumentKind
  origin         DocumentOrigin
  folder         DocumentFolder
  fileName       String         @map("file_name") @db.VarChar(255)
  storageKey     String         @unique @map("storage_key") @db.VarChar(500)
  sha256         String         @db.Char(64)
  sizeBytes      BigInt         @map("size_bytes")
  generatedFrom  String?        @map("generated_from") @db.Char(36)
  sourceFingerprint String?     @map("source_fingerprint") @db.Char(64)
  createdBy      String?        @map("created_by") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(6)

  @@index([proposalId, createdAt], map: "ix_doc_proposal")
  @@map("documents")
}

// ---------------------------------------------------------------------------------------------
// Fase 4 — Workflow e aprovações (migração 0006)
// ---------------------------------------------------------------------------------------------

enum ApprovalScope {
  COMMERCIAL
  LEGAL
}

enum ApprovalMode {
  SEQUENTIAL
  PARALLEL
}

enum ApprovalRequestStatus {
  OPEN
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  SUPERSEDED
}

enum ApprovalDecisionKind {
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalPolicy {
  id            String        @id @db.Char(36)
  name          String        @db.VarChar(100)
  scope         ApprovalScope
  conditionJson Json          @map("condition_json")
  mode          ApprovalMode  @default(SEQUENTIAL)
  levelsJson    Json          @map("levels_json")
  priority      Int           @default(100) @db.SmallInt
  isActive      Boolean       @default(true) @map("is_active")
  validFrom     DateTime      @map("valid_from") @db.Date
  validTo       DateTime?     @map("valid_to") @db.Date

  @@map("approval_policies")
}

model ApprovalRequest {
  id                 String                @id @db.Char(36)
  proposalId         String                @map("proposal_id") @db.Char(36)
  quoteVersionId     String                @map("quote_version_id") @db.Char(36)
  documentId         String                @map("document_id") @db.Char(36)
  policyId           String                @map("policy_id") @db.Char(36)
  policySnapshotJson Json                  @map("policy_snapshot_json")
  scope              ApprovalScope
  status             ApprovalRequestStatus @default(OPEN)
  currentLevel       Int                   @default(1) @map("current_level") @db.TinyInt
  levelDueAt         DateTime?             @map("level_due_at") @db.DateTime(6)
  snapshotHash       String                @map("snapshot_hash") @db.Char(64)
  documentSha256     String                @map("document_sha256") @db.Char(64)
  requestedBy        String                @map("requested_by") @db.Char(36)
  requestedAt        DateTime              @default(now()) @map("requested_at") @db.DateTime(6)
  closedAt           DateTime?             @map("closed_at") @db.DateTime(6)
  decisions          ApprovalDecision[]

  @@index([status, levelDueAt], map: "ix_ar_open")
  @@map("approval_requests")
}

model ApprovalDecision {
  id                String               @id @db.Char(36)
  approvalRequestId String               @map("approval_request_id") @db.Char(36)
  levelNumber       Int                  @map("level_number") @db.TinyInt
  approverUserId    String               @map("approver_user_id") @db.Char(36)
  onBehalfOfUserId  String?              @map("on_behalf_of_user_id") @db.Char(36)
  decision          ApprovalDecisionKind
  comment           String?              @db.Text
  snapshotHash      String               @map("snapshot_hash") @db.Char(64)
  documentSha256    String?              @map("document_sha256") @db.Char(64)
  decidedAt         DateTime             @default(now()) @map("decided_at") @db.DateTime(6)
  request           ApprovalRequest      @relation(fields: [approvalRequestId], references: [id])

  @@unique([approvalRequestId, levelNumber, approverUserId], map: "uq_ad")
  @@map("approval_decisions")
}

model ApprovalDelegation {
  id         String   @id @db.Char(36)
  fromUserId String   @map("from_user_id") @db.Char(36)
  toUserId   String   @map("to_user_id") @db.Char(36)
  validFrom  DateTime @map("valid_from") @db.Date
  validTo    DateTime @map("valid_to") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)

  @@map("approval_delegations")
}
