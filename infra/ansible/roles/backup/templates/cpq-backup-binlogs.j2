#!/bin/sh
# Copia os binlogs fechados para o destino separado a cada 5 minutos (permite recuperação para um ponto no tempo).
set -eu
mariadb --socket=/run/mysqld/mysqld.sock -e 'FLUSH BINARY LOGS'
rsync -a --include 'binlog.[0-9]*' --exclude '*' /var/lib/mysql/ "{{ backup_target }}/binlogs/"
rsync -a "{{ documents_dir }}/" "{{ backup_target }}/documents/"
